{
  "expo": {
    "name": "Qaliye",
    "slug": "qaliye-mobile",
    "scheme": "qaliyedating",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.qaliye.app",
      "supportsTablet": false,
      "appStoreUrl": "https://apps.apple.com/app/id6741631870",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Qaliye needs access to your photos to let you add a profile photo.",
        "NSLocationWhenInUseUsageDescription": "Qaliye uses your location to show you better matches nearby.",
        "NSMicrophoneUsageDescription": "Qaliye needs access to your microphone to record voice messages in support chat."
      }
    },
    "android": {
      "package": "com.qaliye.app",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.qaliye.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#8A2CFF",
          "defaultChannel": "qaliye-default",
          "notificationPermission": "Qaliye sends notifications about matches, messages, and likes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2A0B4F",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          },
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.92774223454-mmu2j3123bc6g7hf1fc3ui9nucljhfk9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Qaliye needs access to your photos to let you add a profile photo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Qaliye uses your location to show you better matches nearby."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Qaliye needs access to your microphone to record voice messages in support chat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d04f735-1300-4ef9-ad68-1325fd6d43ff"
      }
    },
    "owner": "zekariasn"
  }
}
